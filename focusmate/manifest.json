{
  "manifest_version": 3,
  "name": "Focusmate Scheduler",
  "version": "1.0.0",
  "description": "Edit a weekly Focusmate schedule and book it out in one click. Bulk-cancel a date range too.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://app.focusmate.com/*",
    "https://api.focusmate.com/*",
    "https://securetoken.googleapis.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://app.focusmate.com/*"],
      "js": ["api.js", "store.js", "weeks.js", "ui.js", "main.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Focusmate Scheduler",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
